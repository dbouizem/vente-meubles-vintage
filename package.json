{
  "name": "vente-meubles-vintage",
  "version": "1.0.0",
  "private": true,
  "description": "Boutique de meubles vintage - frontend React et API Express",
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm run dev --workspace=back\" \"npm run dev --workspace=front\"",
    "dev:front": "npm run dev --workspace=front",
    "dev:back": "npm run dev --workspace=back",
    "build": "npm run build --workspace=front",
    "lint": "eslint front/src front/tests back --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace=back -- --runInBand",
    "test:integration": "npm run test:integration --workspace=back",
    "test:e2e": "npm run e2e --workspace=front",
    "audit:lh": "npm run audit:lh --workspace=front",
    "start": "node back/serveur.js",
    "check": "npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.6.2"
  }
}
